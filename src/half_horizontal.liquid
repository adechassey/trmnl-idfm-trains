{%- comment -%}
  Horizontal half (800x240): compact table, 5 trains max.
  In portrait orientation the mission column is hidden.
{%- endcomment -%}
{%- assign n = max_trains -%}
{%- if n > 5 -%}{%- assign n = 5 -%}{%- endif -%}
{%- comment -%} Cap at 5 rows, the most this layout can show; data-table-limit still hides any overflow {%- endcomment -%}
{%- if error != "" or rows.size == 0 -%}{%- assign layout_mods = "layout--center" -%}{%- else -%}{%- assign layout_mods = "layout--top layout--stretch-x" -%}{%- endif -%}
<div class="layout layout--col {{ layout_mods }}">
{%- if error != "" -%}
  <span class="title title--small">{{ t_unavailable }}</span>
  <span class="label label--small">{{ error }}</span>
{%- elsif rows.size == 0 -%}
  <span class="title title--small">{{ t_no_trains }}</span>
{%- else -%}
  <table class="table table--small" data-table-limit="true">
    <thead>
      <tr>
        <th><span class="title title--small">{{ t_time }}</span></th>
        <th class="w--12"><span class="title title--small">{{ t_line }}</span></th>
        <th><span class="title title--small">{{ t_destination }}</span></th>
        {%- if has_mission -%}<th class="portrait:hidden"><span class="title title--small">{{ t_mission }}</span></th>{%- endif -%}
        {%- if has_platform -%}<th class="w--20"><span class="title title--small">{{ t_platform }}</span></th>{%- endif -%}
        <th><span class="title title--small">{{ t_status }}</span></th>
      </tr>
    </thead>
    <tbody>
      {%- for row in rows limit: n -%}
        {%- assign r = row | split: "|" -%}
        <tr>
          <td><span class="label">{{ r[2] }}</span></td>
          <td class="w--12"><span class="label label--small label--filled">{{ r[3] }}</span></td>
          <td><span class="label label--small lg:label--base">{{ r[10] }}</span></td>
          {%- if has_mission -%}<td class="portrait:hidden"><span class="label label--small lg:label--base">{{ r[5] }}</span></td>{%- endif -%}
          {%- if has_platform -%}<td class="w--20"><span class="label label--small lg:label--base">{{ r[6] }}</span></td>{%- endif -%}
          <td>
            {%- case r[8] -%}
              {%- when "cancelled" -%}<span class="label label--small label--filled lg:label--base">{{ t_cancelled }}</span>
              {%- when "delayed" -%}<span class="label label--small label--filled lg:label--base">+{{ r[7] }} min</span>
              {%- when "atstop" -%}<span class="label label--small lg:label--base">{{ t_at_platform }}</span>
              {%- else -%}<span class="label label--small lg:label--base">{{ t_on_time }}</span>
            {%- endcase -%}
          </td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>
{%- endif -%}
</div>

{% render 'title_bar', title: station_title, instance: now_local %}
